  createdBy         User                   @relation("TitleReviewLinkCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  revokedBy         User?                  @relation("TitleReviewLinkRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull)
  decision          TitleReviewDecision?

  @@index([tenantId, clientId, status])
  @@index([proposalId, version, status])
  @@index([expiresAt, status])
}

model TitleReviewDecision {
  id            String                   @id @default(uuid()) @db.Uuid
  linkId        String                   @unique @db.Uuid
  type          ClientReviewDecisionType
  reason        String                   @db.VarChar(2000)
  reviewerName  String                   @db.VarChar(160)
  reviewerEmail String                   @db.VarChar(254)
  ipAddress     String?                  @db.VarChar(64)
  userAgent     String?                  @db.VarChar(500)
  createdAt     DateTime                 @default(now()) @db.Timestamptz(3)
  link          TitleReviewLink          @relation(fields: [linkId], references: [id], onDelete: Cascade)
}

model TitlePackageReviewLink {
  id                String                   @id @default(uuid()) @db.Uuid
  tenantId          String                   @db.Uuid
  clientId          String                   @db.Uuid
  generationRunId   String                   @db.Uuid
  tokenHash         String                   @unique @db.Char(64)
  status            ClientReviewLinkStatus   @default(ACTIVE)
  recipientName     String                   @db.VarChar(160)
  recipientEmail    String                   @db.VarChar(254)
  expiresAt         DateTime                 @db.Timestamptz(3)
  maxViews          Int                      @default(100)
  approvalTarget    Int                      @default(4)
  viewCount         Int                      @default(0)
  lastViewedAt      DateTime?                @db.Timestamptz(3)
  createdById       String                   @db.Uuid
  revokedById       String?                  @db.Uuid
  revokedAt         DateTime?                @db.Timestamptz(3)
  sentByEmail       String?                  @db.VarChar(254)
  emailSubject      String?                  @db.VarChar(300)
  externalMessageId String?                  @db.VarChar(500)
  sentAt            DateTime?                @db.Timestamptz(3)
  createdAt         DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime                 @updatedAt @db.Timestamptz(3)
  tenant            Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  client            Client                   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  generationRun     AiGenerationRun          @relation(fields: [generationRunId], references: [id], onDelete: Cascade)
  createdBy         User                     @relation("TitlePackageReviewLinkCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  revokedBy         User?                    @relation("TitlePackageReviewLinkRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull)
  items             TitlePackageReviewItem[]

  @@index([tenantId, clientId, status])
  @@index([generationRunId, status])
  @@index([expiresAt, status])
}

model TitlePackageReviewItem {
  id         String                      @id @default(uuid()) @db.Uuid
  linkId     String                      @db.Uuid
  proposalId String                      @db.Uuid
  version    Int
  position   Int
  link       TitlePackageReviewLink      @relation(fields: [linkId], references: [id], onDelete: Cascade)
  proposal   TitleProposal               @relation(fields: [proposalId], references: [id], onDelete: Restrict)
  decision   TitlePackageReviewDecision?

  @@unique([linkId, proposalId])
  @@index([proposalId, version])
}

model TitlePackageReviewDecision {
  id            String                   @id @default(uuid()) @db.Uuid
  itemId        String                   @unique @db.Uuid
  type          ClientReviewDecisionType
  reason        String                   @db.VarChar(2000)
  reviewerName  String                   @db.VarChar(160)
  reviewerEmail String                   @db.VarChar(254)
  ipAddress     String?                  @db.VarChar(64)
  userAgent     String?                  @db.VarChar(500)
  createdAt     DateTime                 @default(now()) @db.Timestamptz(3)
  item          TitlePackageReviewItem   @relation(fields: [itemId], references: [id], onDelete: Cascade)
}
