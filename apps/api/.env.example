NODE_ENV=development
PORT=4100
API_PREFIX=api/v1
DEFAULT_TENANT_CODE=mood
DATABASE_URL=postgresql://ihere:ihere_local_only@localhost:54329/ihere?schema=public
CORS_ORIGINS=http://localhost:3001
PUBLIC_WEB_URL=http://localhost:3001
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=14
LOGIN_ALIAS_PEPPER=replace-with-a-different-32-character-secret
COOKIE_SECURE=false
TRUST_PROXY=false
SWAGGER_ENABLED=true
REDIS_URL=redis://localhost:63799
TITLE_EVALUATION_WORKER_ENABLED=true
TITLE_EVALUATION_CONCURRENCY=2
TITLE_EVALUATION_TIMEOUT_MS=30000
NOTE_QA_WORKER_ENABLED=true
NOTE_QA_CONCURRENCY=2
NOTE_QA_TIMEOUT_MS=30000
EXPORT_WORKER_ENABLED=true
EXPORT_CONCURRENCY=2
EXPORT_TIMEOUT_MS=120000
EXPORT_STORAGE_DIR=storage/exports
OUTBOX_POLL_INTERVAL_MS=1000
AI_GENERATION_ENABLED=false
OPENAI_API_KEY=
AI_PRIMARY_MODEL=gpt-5.6-terra
AI_ESCALATION_MODEL=gpt-5.6-sol
AI_REASONING_EFFORT=medium
AI_GENERATION_WORKER_ENABLED=true
AI_GENERATION_CONCURRENCY=1
AI_GENERATION_TIMEOUT_MS=300000
AI_MONTHLY_BUDGET_MICROS=15000000
AI_RUN_BUDGET_MICROS=750000
AI_MAX_OUTPUT_TOKENS=12000
ANALYTICS_ENABLED=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4100/api/v1/analytics/oauth/google/callback
ANALYTICS_TOKEN_ENCRYPTION_KEY=

# Solo se usan durante el seed local. No se versionan valores reales.
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Administrador I HERE
BOOTSTRAP_ADMIN_EMAIL=
